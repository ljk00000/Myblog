# Local development example. Copy to .env.local and adjust for your environment.
# For production, run node script/blog-admin/build-frontend.cjs from the repository root.
VITE_APP_TITLE=Myblog 管理后台
VITE_PORT=80
VITE_OPEN=false
VITE_BASE_PATH=/
VITE_BASE_URL=http://127.0.0.1:48080
VITE_API_URL=/admin-api
VITE_OUT_DIR=dist-prod
VITE_UPLOAD_TYPE=server
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_TENANT_ENABLE=true
VITE_APP_DEFAULT_LOGIN_TENANT=
VITE_APP_DEFAULT_LOGIN_USERNAME=
VITE_APP_DEFAULT_LOGIN_PASSWORD=
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_BAIDU_CODE=
VITE_APP_DOCALERT_ENABLE=false
VITE_USE_ONLINE_ICON=true
VITE_USE_BUNDLE_ANALYZER=false
VITE_SOURCEMAP=false
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_COMPRESS=gzip
